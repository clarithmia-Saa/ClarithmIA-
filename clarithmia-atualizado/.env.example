# ---------------------------------------------------------------------------
# ClarithmIA backend (Netlify Functions). Copy to `.env` for `netlify dev`,
# and set the same keys in Netlify > Site settings > Environment variables.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Access control ---------------------------------------------------------
# Protects /api/connectors/*  (send as `x-api-key` or `Authorization: Bearer`).
# Comma-separated list (INTERNAL_API_KEYS) allows zero-downtime rotation.
INTERNAL_API_KEY=change-me-long-random-string

# Protects /api/webhooks/incoming (header `x-webhook-token` or Bearer).
WEBHOOK_SECRET=change-me-another-long-random-string
# Optional: when set, the webhook also requires `x-signature: sha256=<hmac-hex>`
# computed over the raw body with this secret.
# WEBHOOK_SIGNING_SECRET=

# --- Zendesk ---------------------------------------------------------------
ZENDESK_SUBDOMAIN=yourcompany
# Preferred: OAuth access token, sent as `Authorization: Bearer`.
ZENDESK_ACCESS_TOKEN=
# Fallback when no OAuth token exists: API token (Zendesk expects Basic auth for it).
# ZENDESK_EMAIL=admin@yourcompany.com
# ZENDESK_API_TOKEN=
# ZENDESK_MAX_LOOKBACK_DAYS=30

# --- X / Twitter (API v2) ---------------------------------------------------
TWITTER_BEARER_TOKEN=
# Account whose mentions are read. Provide the id, or the username to resolve it.
TWITTER_USER_ID=
# TWITTER_USERNAME=yourbrand
# TWITTER_API_BASE=https://api.x.com/2

# --- Persistence (optional; without it results are only returned) ----------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_FEEDBACK_TABLE=feedback

# --- Tuning -----------------------------------------------------------------
# LOG_LEVEL=info                    # debug | info | warn | error
# REQUEST_DEADLINE_MS=8000          # total time budget per request (1000-25000)
# UPSTREAM_TIMEOUT_MS=6000          # per-attempt upstream timeout
# UPSTREAM_MAX_RETRIES=2
# UPSTREAM_RETRY_BASE_MS=300
# WEBHOOK_MAX_BODY_BYTES=262144
# WEBHOOK_MAX_ITEMS=100
# AI_SIMULATED_LATENCY_MS=0
# CORS_ALLOWED_ORIGINS=https://app.clarithmia.com   # browsers only; comma-separated or *
